---
import { ClientRouter } from 'astro:transitions';
import { SITE, SOCIALS, LINKS } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** Keep utility pages (the 404) out of search results. */
  noindex?: boolean;
}

const { title, description = SITE.description, noindex = false } = Astro.props;
const site = Astro.site ?? SITE.url;
const canonical = new URL(Astro.url.pathname, site);
// Per-route OG cards generated by src/pages/og/[slug].png.ts; logo.jpg as fallback
const ogSlug: Record<string, string> = {
  '/': 'index',
  '/projects': 'projects',
  '/links': 'links',
};
const pathnameKey = Astro.url.pathname.replace(/\/$/, '') || '/';
const hasOgCard = pathnameKey in ogSlug;
const ogImage = new URL(hasOgCard ? `/og/${ogSlug[pathnameKey]}.png` : 'logo.jpg', site);
const sameAs = [
  ...new Set([
    ...SOCIALS.map((s) => s.href),
    ...LINKS.filter((l) => l.platform !== 'Email').map((l) => l.href),
    'https://greasyfork.org/en/users/1136673-yungsamd17',
  ]),
];
const birthDate = `${SITE.birthDate.getFullYear()}-${String(SITE.birthDate.getMonth() + 1).padStart(2, '0')}-${String(SITE.birthDate.getDate()).padStart(2, '0')}`;
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  alternateName: SITE.handle,
  url: `${SITE.url}/`,
  email: `mailto:${SITE.email}`,
  jobTitle: 'Web Developer',
  birthDate,
  sameAs,
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.ico?v=2" sizes="any" data-astro-transition-persist="favicon-ico" />
<link rel="icon" href="/favicon-32x32.png?v=2" type="image/png" sizes="32x32" data-astro-transition-persist="favicon-32" />
<link rel="icon" href="/icon-192.png?v=2" type="image/png" sizes="192x192" data-astro-transition-persist="icon-192" />
<link rel="icon" href="/icon-512.png?v=2" type="image/png" sizes="512x512" data-astro-transition-persist="icon-512" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" sizes="180x180" data-astro-transition-persist="apple-touch-icon" />
<link rel="manifest" href="/site.webmanifest?v=2" data-astro-transition-persist="webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content={hasOgCard ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#0e0e10" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#e8e8ec" media="(prefers-color-scheme: light)" />
<meta name="google-site-verification" content="56-L3iSwypOtQIwMAVZwT51iLhmZTG1h1F88WIN3bGI" />

<script is:inline>
  (() => {
    try {
      let mode = localStorage.getItem('theme');
      if (mode !== 'light' && mode !== 'dark') mode = 'system';
      const dark = mode === 'dark' || (mode === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      document.documentElement.dataset.themeMode = mode;
      document.documentElement.classList.toggle('dark', dark);
    } catch {
      document.documentElement.dataset.theme = 'dark';
      document.documentElement.dataset.themeMode = 'system';
      document.documentElement.classList.add('dark');
    }
    try {
      let lang = localStorage.getItem('lang');
      if (lang !== 'sk' && lang !== 'en') {
        const prefs = navigator.languages?.length ? navigator.languages : [navigator.language];
        lang = prefs.some((l) => l?.toLowerCase().startsWith('sk')) ? 'sk' : 'en';
      }
      document.documentElement.lang = lang;
    } catch {
      document.documentElement.lang = 'en';
    }
    // The site owns scroll restoration; tell the browser early so a reload
    // (e.g. mobile pull-to-refresh) never restores a stale offset.
    try {
      history.scrollRestoration = 'manual';
      // Hide the page until the remembered scroll offset is restored, so a
      // stale position never flashes on screen during a reload.
      document.documentElement.style.visibility = 'hidden';
      setTimeout(() => { document.documentElement.style.visibility = ''; }, 300);
    } catch {}
    try {
      if (localStorage.getItem('textanim') !== 'on') document.documentElement.dataset.textanim = 'off';
    } catch {}
    try {
      // toasts are on by default; only an explicit opt-out suppresses them
      if (localStorage.getItem('toast') === 'off') document.documentElement.dataset.toast = 'off';
    } catch {}
    // The glow is off in the static markup, so it also stays off without JS.
    // An explicit opt-in is the only case where it is removed before paint.
    try {
      if (localStorage.getItem('pageglow') === 'on') delete document.documentElement.dataset.pageglow;
    } catch {}
    try {
      if (localStorage.getItem('avataregg') === 'on') document.documentElement.dataset.avataregg = 'on';
    } catch {}
  })();
</script>

<ClientRouter />
