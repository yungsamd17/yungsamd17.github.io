---
import Icon from './Icon.astro';
import { t } from '../i18n/ui';
---

<div class="card-glass relative size-9 rounded-full grid place-items-center text-mid hover:text-hi hover:border-accent/40">
  <Icon name="globe" size={15} class="pointer-events-none" />
  <select
    id="lang-select"
    aria-label={t('langToggle')}
    class="absolute inset-0 size-full opacity-0 cursor-pointer"
  >
    <option value="en">English</option>
    <option value="sk">Slovenčina</option>
  </select>
</div>
