---
import Icon from './Icon.astro';
import { t } from '../i18n/ui';
---

<div class="lang-toggle lang-select-wrap">
  <Icon name="language" size={13} class="pointer-events-none" />
  <select id="lang-select" aria-label={t('langToggle')}>
    <option value="en">English</option>
    <option value="sk">Slovak</option>
  </select>
</div>
