---
import { brandIcons, strokeIcons, type IconName } from '../icons';

interface Props {
  name: IconName;
  class?: string;
  size?: number;
}

const { name, class: className, size = 16 } = Astro.props;

const isBrand = name in brandIcons;
const def = isBrand ? brandIcons[name] : strokeIcons[name];
const parts = def ? def.split('|') : [];
const circles = parts.filter((p) => p.startsWith('circle:'));
const paths = parts.filter((p) => !p.startsWith('circle:'));
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isBrand ? 'currentColor' : 'none'}
  stroke={isBrand ? 'none' : 'currentColor'}
  stroke-width={isBrand ? undefined : 2}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
>
  {paths.map((d) => <path d={d} />)}
  {
    circles.map((c) => {
      const [, cx, cy, r] = c.split(':').flatMap((v) => v.split(','));
      return <circle cx={cx} cy={cy} r={r} />;
    })
  }
</svg>
