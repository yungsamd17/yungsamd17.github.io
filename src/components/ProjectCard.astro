---
import Icon from './Icon.astro';
import type { Project } from '../data/site';

interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;
---

<a
  href={project.href}
  target={project.href.startsWith('http') ? '_blank' : undefined}
  rel="noopener"
  class="card-glass group block rounded-2xl p-5 hover:-translate-y-0.5 hover:border-accent/40 hover:shadow-[0_8px_40px_-12px_var(--accent-soft)] reveal"
  style={`--reveal-delay: ${index * 0.06}s`}
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-medium text-[0.95rem] text-hi group-hover:text-accent transition-colors duration-200">
      {project.title}
    </h3>
    <span
      class="text-low group-hover:text-accent group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-200 shrink-0 mt-0.5"
    >
      <Icon name="arrow-up-right" size={15} />
    </span>
  </div>

  <div class="flex flex-wrap items-center gap-1.5 mt-2">
    {
      project.live && (
        <span class="pill pill-live">
          <span class="pill-dot" />
          Live
        </span>
      )
    }
    {project.langs.map((lang) => <span class="pill">{lang}</span>)}
  </div>

  <p class="mt-3 text-sm font-light leading-relaxed text-mid">
    <span data-lang="en">{project.desc.en}</span>
    <span data-lang="sk">{project.desc.sk}</span>
  </p>
</a>
