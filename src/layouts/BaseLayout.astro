---
import '@fontsource-variable/inter';
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import { t } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  standalone?: boolean;
}

const { title, description, standalone = false } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark" data-theme-mode="system">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <a href="#main" class="skip-link">{t('skipToContent')}</a>
    <noscript>This site works best with JavaScript enabled.</noscript>

    <script>
      import '../scripts/app';
    </script>

    {
      standalone ? (
        <main id="main" class="links-container">
          <slot />
        </main>
      ) : (
        <>
          <main id="main" class="page">
            <slot />
          </main>
          <Footer />
        </>
      )
    }
  </body>
</html>
