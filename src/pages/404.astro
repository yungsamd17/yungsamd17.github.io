---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { t } from '../i18n/ui';
---

<BaseLayout title={`404 · ${t('notFoundTitle')}`} standalone>
  <div style="text-align: center;">
    <h2 style="margin-top: 40px;">
      <span data-lang="en">{t('notFoundTitle')}</span><span data-lang="sk">{t('notFoundTitle', 'sk')}</span>
    </h2>
    <p style="margin-top: 12px; color: var(--mid); font-weight: 300;">
      <span data-lang="en">{t('notFoundText')}</span><span data-lang="sk">{t('notFoundText', 'sk')}</span>
    </p>
    <a href="/" class="back" style="justify-content: center; margin-top: 24px;">
      <Icon name="arrow-left" size={12} />
      yungsamd17.github.io
    </a>
  </div>
</BaseLayout>
