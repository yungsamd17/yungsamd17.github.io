---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
import { t } from '../i18n/ui';
---

<BaseLayout title={`404 · ${t('notFoundTitle')} | ${SITE.title}`} hideNav>
  <div class="min-h-[60dvh] grid place-items-center text-center">
    <div>
      <p class="font-mono text-7xl font-semibold tracking-tighter text-hi reveal">
        4<span class="text-accent">0</span>4
      </p>
      <p class="micro-label mt-4 reveal" style="--reveal-delay: 0.08s">{t('notFoundTitle')}</p>
      <p class="mt-3 text-mid font-light reveal" style="--reveal-delay: 0.16s">
        <span data-lang="en">{t('notFoundText')}</span>
        <span data-lang="sk">{t('notFoundText', 'sk')}</span>
      </p>
      <a
        href="/"
        class="card-glass mt-8 inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm text-mid hover:text-accent hover:border-accent/40 hover:-translate-y-0.5 transition-all reveal"
        style="--reveal-delay: 0.24s"
      >
        <Icon name="arrow-left" size={14} />
        yungsamd17.github.io
      </a>
    </div>
  </div>
</BaseLayout>
