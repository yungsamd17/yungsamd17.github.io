---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
import { t } from '../i18n/ui';

const OPTIONS = [
  { id: 'redesign-toggle', label: 'extrasRedesignLabel', desc: 'extrasRedesignDesc' },
  { id: 'textanim-toggle', label: 'extrasTextAnimLabel', desc: 'extrasTextAnimDesc' },
  { id: 'anim-toggle', label: 'extrasAnimLabel', desc: 'extrasAnimDesc' },
  { id: 'toast-toggle', label: 'extrasToastLabel', desc: 'extrasToastDesc' },
  { id: 'pageglow-toggle', label: 'extrasPageGlowLabel', desc: 'extrasPageGlowDesc' },
  { id: 'avataregg-toggle', label: 'extrasAvatarEggLabel', desc: 'extrasAvatarEggDesc' },
] as const;

const THEME_TRANSITIONS = [
  { id: 'none', label: 'themeTransitionNoneLabel', desc: 'themeTransitionNoneDesc' },
  { id: 'fade', label: 'themeTransitionFadeLabel', desc: 'themeTransitionFadeDesc' },
  { id: 'crossfade', label: 'themeTransitionCrossfadeLabel', desc: 'themeTransitionCrossfadeDesc' },
  { id: 'circle', label: 'themeTransitionCircleLabel', desc: 'themeTransitionCircleDesc' },
  { id: 'wipe', label: 'themeTransitionWipeLabel', desc: 'themeTransitionWipeDesc' },
] as const;
---

<BaseLayout title={`${t('extrasTitle')} | ${SITE.title}`}>
  <a href="/" class="back">
    <Icon name="arrow-left" size={12} />
    <span data-lang="en">{t('back')}</span>
    <span data-lang="sk">{t('back', 'sk')}</span>
  </a>

  <header class="extras-header">
    <h1 class="extras-title">
      <span data-lang="en">{t('extrasTitle')}</span>
      <span data-lang="sk">{t('extrasTitle', 'sk')}</span>
    </h1>
    <p class="extras-lede">
      <span data-lang="en">{t('extrasText')}</span>
      <span data-lang="sk">{t('extrasText', 'sk')}</span>
    </p>
  </header>

  <section class="extras-group">
    <h2 class="extras-group-title">
      <span data-lang="en">{t('extrasLab')}</span>
      <span data-lang="sk">{t('extrasLab', 'sk')}</span>
    </h2>

    <div class="extras-options">
      {
        OPTIONS.map((option) => (
          <label class="opt">
            <span class="opt-copy">
              <span class="opt-label">
                <span data-lang="en">{t(option.label)}</span>
                <span data-lang="sk">{t(option.label, 'sk')}</span>
              </span>
              <span class="opt-desc">
                <span data-lang="en">{t(option.desc)}</span>
                <span data-lang="sk">{t(option.desc, 'sk')}</span>
              </span>
            </span>
            <input type="checkbox" id={option.id} role="switch" />
            <span class="switch-ui" aria-hidden="true"><span class="switch-thumb" /></span>
          </label>
        ))
      }
    </div>
  </section>

  <section class="extras-group">
    <fieldset class="extras-fieldset">
      <legend class="extras-group-title">
        <span data-lang="en">{t('extrasThemeTransitionLabel')}</span>
        <span data-lang="sk">{t('extrasThemeTransitionLabel', 'sk')}</span>
      </legend>
      <p class="extras-group-note">
        <span data-lang="en">{t('extrasThemeTransitionDesc')}</span>
        <span data-lang="sk">{t('extrasThemeTransitionDesc', 'sk')}</span>
      </p>
      <div class="vt-options">
        {
          THEME_TRANSITIONS.map((option) => (
            <label class="vt-opt">
              <input type="radio" name="theme-transition" value={option.id} data-theme-transition />
              <span class="opt-copy">
                <span class="opt-label">
                  <span data-lang="en">{t(option.label)}</span>
                  <span data-lang="sk">{t(option.label, 'sk')}</span>
                </span>
                <span class="opt-desc">
                  <span data-lang="en">{t(option.desc)}</span>
                  <span data-lang="sk">{t(option.desc, 'sk')}</span>
                </span>
              </span>
              <span class="vt-radio" aria-hidden="true" />
            </label>
          ))
        }
      </div>
    </fieldset>
  </section>
</BaseLayout>
