---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import LangSelect from '../components/LangSelect.astro';
import { SITE, SOCIALS, FEATURED } from '../data/site';
import { t } from '../i18n/ui';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  sameAs: SOCIALS.map((s) => s.href),
  jobTitle: 'Web Developer',
});
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <script type="application/ld+json" set:html={jsonLd} />

  <header class="flex items-center justify-between gap-4 reveal">
    <div class="flex items-center gap-4">
      <div class="relative shrink-0">
        <img
          src="/logo.jpg"
          alt=""
          width="56"
          height="56"
          class="size-14 rounded-2xl object-cover ring-1 ring-line squircle"
        />
        <span
          class="absolute -bottom-0.5 -right-0.5 size-3 rounded-full bg-[oklch(0.75_0.17_150)] ring-2 ring-bg"
          title="online"
        >
        </span>
      </div>
      <div>
        <h1 class="text-3xl font-semibold tracking-tight leading-none">{SITE.name}</h1>
        <a
          href="/links/"
          class="mt-1.5 inline-flex items-center gap-1 font-mono text-xs text-low hover:text-accent transition-colors"
        >
          @{SITE.handle}
        </a>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <LangSelect />
      <ThemeToggle />
    </div>
  </header>

  <p
    data-easter="tagline"
    class="mt-6 text-mid font-light cursor-pointer select-none hover:text-hi transition-colors reveal"
    style="--reveal-delay: 0.05s"
    title=":)"
  >
    <span data-lang="en">{t('tagline')}</span>
    <span data-lang="sk">{t('tagline', 'sk')}</span>
  </p>

  <p
    class="mt-3 inline-flex items-center gap-2 pill pill-live reveal"
    style="--reveal-delay: 0.1s"
  >
    <span class="pill-dot"></span>
    <span data-lang="en">{t('status')}</span>
    <span data-lang="sk">{t('status', 'sk')}</span>
  </p>

  <ul class="mt-6 flex items-center gap-2 reveal" style="--reveal-delay: 0.15s">
    {
      SOCIALS.map((social) => (
        <li>
          <a
            href={social.href}
            target="_blank"
            rel="noopener"
            aria-label={social.label}
            title={social.label}
            class="card-glass size-10 rounded-xl grid place-items-center text-mid hover:text-accent hover:-translate-y-0.5 hover:border-accent/40"
          >
            <Icon name={social.icon} size={17} />
          </a>
        </li>
      ))
    }
  </ul>

  <section class="mt-12" aria-labelledby="featured-heading">
    <h2 id="featured-heading" class="micro-label mb-3 reveal" style="--reveal-delay: 0.2s">
      {t('featuredLabel')}
    </h2>
    <div class="grid gap-3">
      {
        FEATURED.map((item, i) => (
          <a
            href={item.href}
            target="_blank"
            rel="noopener"
            class="card-glass group flex items-center gap-4 rounded-2xl p-4 hover:-translate-y-0.5 hover:border-accent/40 hover:shadow-[0_8px_40px_-12px_var(--accent-soft)] reveal"
            style={`--reveal-delay: ${0.22 + i * 0.06}s`}
          >
            <span class="card-glass size-11 rounded-xl grid place-items-center text-accent shrink-0 group-hover:border-accent/40 transition-colors">
              <Icon name={item.icon} size={19} />
            </span>
            <span class="min-w-0 flex-1">
              <span class="flex items-center gap-2">
                <span class="font-medium text-[0.95rem] text-hi group-hover:text-accent transition-colors truncate">
                  {item.title}
                </span>
                {item.badge && (
                  <span class="pill uppercase">
                    <Icon name="github" size={9} />
                    {item.badge}
                  </span>
                )}
              </span>
              <span class="block mt-0.5 text-sm font-light text-mid leading-snug">
                <span data-lang="en">{item.desc.en}</span>
                <span data-lang="sk">{item.desc.sk}</span>
              </span>
            </span>
            <span class="text-low group-hover:text-accent group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-200 shrink-0">
              <Icon name="arrow-up-right" size={16} />
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mt-10 mb-8" aria-labelledby="explore-heading">
    <h2 id="explore-heading" class="micro-label mb-3 reveal" style="--reveal-delay: 0.42s">
      {t('exploreLabel')}
    </h2>
    <div class="grid sm:grid-cols-2 gap-3">
      <a
        href="/projects/"
        class="card-glass group flex items-center justify-between rounded-2xl px-5 py-4 hover:-translate-y-0.5 hover:border-accent/40 reveal"
        style="--reveal-delay: 0.46s"
      >
        <span class="font-medium text-[0.95rem] text-hi group-hover:text-accent transition-colors">
          {t('navProjects')}
        </span>
        <span class="text-low group-hover:text-accent group-hover:translate-x-0.5 transition-all duration-200">
          <Icon name="arrow-up-right" size={16} />
        </span>
      </a>
      <a
        href="/about/"
        class="card-glass group flex items-center justify-between rounded-2xl px-5 py-4 hover:-translate-y-0.5 hover:border-accent/40 reveal"
        style="--reveal-delay: 0.52s"
      >
        <span class="font-medium text-[0.95rem] text-hi group-hover:text-accent transition-colors">
          {t('navAbout')}
        </span>
        <span class="text-low group-hover:text-accent group-hover:translate-x-0.5 transition-all duration-200">
          <Icon name="arrow-up-right" size={16} />
        </span>
      </a>
    </div>
  </section>
</BaseLayout>
