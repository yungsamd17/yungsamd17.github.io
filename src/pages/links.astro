---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE, LINKS } from '../data/site';
import { t } from '../i18n/ui';
---

<BaseLayout
  title={`${t('linksTitle')} | ${SITE.title}`}
  description={t('linksMeta')}
  hideNav
>
  <div class="max-w-sm mx-auto w-full">
    <header class="text-center mb-8 reveal">
      <img
        src="/logo.jpg"
        alt=""
        width="72"
        height="72"
        class="size-18 mx-auto rounded-2xl object-cover ring-1 ring-line squircle"
      />
      <h1 class="mt-4 text-xl font-semibold tracking-tight">{SITE.name}</h1>
      <p class="font-mono text-xs text-low mt-1">@{SITE.handle}</p>
    </header>

    <div class="grid gap-2.5">
      {
        LINKS.map((link, i) => (
          <a
            href={link.href}
            target={link.href.startsWith('mailto') ? undefined : '_blank'}
            rel="noopener"
            class="card-glass group flex items-center gap-3.5 rounded-2xl px-4 py-3.5 hover:-translate-y-0.5 hover:border-accent/40 reveal"
            style={`--reveal-delay: ${0.05 + i * 0.04}s`}
          >
            <span class="text-mid group-hover:text-accent group-hover:scale-110 transition-all duration-200 shrink-0">
              <Icon name={link.icon} size={18} />
            </span>
            <span class="flex-1 min-w-0">
              <span class="block text-sm font-medium text-hi">{link.platform}</span>
              <span class="block font-mono text-[0.7rem] text-low truncate">{link.username}</span>
            </span>
            <span class="text-low opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 group-hover:text-accent transition-all duration-200 shrink-0">
              <Icon name="arrow-up-right" size={14} />
            </span>
          </a>
        ))
      }

      <a
        href="/"
        class="card-glass group flex items-center gap-3.5 rounded-2xl px-4 py-3.5 hover:-translate-y-0.5 hover:border-accent/40 mt-3 reveal"
        style={`--reveal-delay: ${0.05 + LINKS.length * 0.04}s`}
      >
        <span class="text-mid group-hover:text-accent transition-colors shrink-0">
          <Icon name="arrow-left" size={16} />
        </span>
        <span class="flex-1 min-w-0">
          <span class="block text-sm font-medium text-hi">{t('linksBack')}</span>
          <span class="block font-mono text-[0.7rem] text-low">yungsamd17.github.io</span>
        </span>
      </a>
    </div>

    <p class="text-center font-mono text-[0.6875rem] text-low mt-8 reveal" style="--reveal-delay: 0.45s">
      © 2023–<span class="year">2026</span> {SITE.name} ({SITE.handle})
    </p>
  </div>
</BaseLayout>
