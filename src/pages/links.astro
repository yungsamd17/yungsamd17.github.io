---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE, LINKS } from '../data/site';
import { t } from '../i18n/ui';
---

<BaseLayout
  title={`${t('linksTitle')} | ${SITE.title}`}
  description={t('linksMeta')}
  standalone
>
  <div class="links-header">
    <h1>{SITE.name}</h1>
    <span class="handle">@{SITE.handle}</span>
    <p class="links-intro">
      <span data-lang="en">{t('linksIntro')}</span>
      <span data-lang="sk">{t('linksIntro', 'sk')}</span>
    </p>
  </div>

  <div class="links-list">
    {
      LINKS.map((link) =>
        link.copy ? (
          <div class="link-item">
            <a href={link.href} class="link-main">
              <Icon name={link.icon} size={17} />
              <div class="link-info">
                <span class="link-platform">{link.platform}</span>
              </div>
            </a>
            <button type="button" class="copy-btn" data-copy={link.copy} aria-label={t('copyEmail')}>
              <span class="copy-icon-wrap">
                <Icon name="copy" size={16} />
                <Icon name="check" size={16} />
              </span>
            </button>
          </div>
        ) : (
          <a
            href={link.href}
            target={link.href.startsWith('mailto') ? undefined : '_blank'}
            rel="noopener"
            class="link-item"
          >
            <Icon name={link.icon} size={17} />
            <div class="link-info">
              <span class="link-platform">{link.platform}</span>
            </div>
            <Icon name="arrow-up-right" size={7} class="card-arrow" />
          </a>
        )
      )
    }
  </div>
</BaseLayout>
