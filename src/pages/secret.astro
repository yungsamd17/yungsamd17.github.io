---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
import { t } from '../i18n/ui';
---

<BaseLayout title={`🎉 ${t('secretTitle')} | ${SITE.title}`} hideNav>
  <div class="min-h-[60dvh] grid place-items-center text-center">
    <div>
      <p class="text-6xl mb-6 reveal" aria-hidden="true">🎉</p>
      <h1 class="text-2xl font-semibold tracking-tight reveal" style="--reveal-delay: 0.08s">
        <span data-lang="en">{t('secretTitle')}</span>
        <span data-lang="sk">{t('secretTitle', 'sk')}</span>
      </h1>
      <p class="mt-3 text-mid font-light reveal" style="--reveal-delay: 0.16s">
        <span data-lang="en">{t('secretText')}</span>
        <span data-lang="sk">{t('secretText', 'sk')}</span>
      </p>
      <a
        href="/"
        class="card-glass mt-8 inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm text-mid hover:text-accent hover:border-accent/40 hover:-translate-y-0.5 transition-all reveal"
        style="--reveal-delay: 0.24s"
      >
        <Icon name="arrow-left" size={14} />
        {SITE.name}.dev
      </a>
    </div>
  </div>
</BaseLayout>
