---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { t } from '../i18n/ui';
---

<BaseLayout title={`🎉 ${t('secretTitle')}`}>
  <a href="/" class="back">
    <Icon name="arrow-left" size={12} />
    <span data-lang="en">{t('back')}</span>
    <span data-lang="sk">{t('back', 'sk')}</span>
  </a>

  <h2>
    🎉 <span data-lang="en">{t('secretTitle')}</span><span data-lang="sk">{t('secretTitle', 'sk')}</span>
  </h2>

  <p class="about-text">
    <span data-lang="en">{t('secretText')}</span>
    <span data-lang="sk">{t('secretText', 'sk')}</span>
  </p>

  <div class="lab-section">
    <h3 class="lab-title">
      <span data-lang="en">{t('secretLab')}</span>
      <span data-lang="sk">{t('secretLab', 'sk')}</span>
    </h3>
    <label class="switch-row">
      <input type="checkbox" id="anim-toggle" role="switch" />
      <span>
        <span data-lang="en">{t('secretAnimLabel')}</span>
        <span data-lang="sk">{t('secretAnimLabel', 'sk')}</span>
      </span>
      <span class="switch-ui" aria-hidden="true"><span class="switch-thumb"></span></span>
    </label>
  </div>
</BaseLayout>
